properties([
  pipelineTriggers([cron('H/5 * * * *')]),
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '30'))
])

node('agent_koziol') {
  timestamps {
    timeout(time: 5, unit: 'MINUTES') {
      try {
        stage('Kod monitora') {
          deleteDir()
          checkout scm
        }
        stage('DNS BIND i AdGuard oraz HTTP health') {
          sh 'python3 ci/monitoring.py'
        }
      } catch (error) {
        currentBuild.result = 'FAILURE'
        emailext(
          to: 'nk316070@student.polsl.pl',
          subject: "ALARM portalu: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
          body: "Monitoring DNS/HTTP portalu www.koziol.lan wykryl blad.\n${env.BUILD_URL}console"
        )
        throw error
      }
    }
  }
}
